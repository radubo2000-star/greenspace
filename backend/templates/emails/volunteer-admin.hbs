<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
  <h2 style="color: #3b82f6;">Aplicatie noua de voluntariat</h2>
  <div style="background-color: #f3f4f6; padding: 20px; border-radius: 8px; margin: 20px 0;">
    <p><strong>Nume:</strong> {{name}}</p>
    <p><strong>Email:</strong> {{email}}</p>
    <p><strong>Telefon:</strong> {{phone}}</p>
    <p><strong>Varsta:</strong> {{age}} ani</p>
    <p><strong>Oras:</strong> {{city}}</p>
    <p><strong>Disponibilitate:</strong> {{availability}}</p>
  </div>
  <div style="background-color: #ffffff; padding: 20px; border: 1px solid #e5e7eb; border-radius: 8px; margin: 20px 0;">
    <h3 style="color: #374151; margin-top: 0;">Domenii de interes:</h3>
    <ul style="color: #4b5563;">
      {{#each interests}}<li>{{this}}</li>{{/each}}
    </ul>
  </div>
  {{#ifExists experience}}
  <div style="background-color: #ffffff; padding: 20px; border: 1px solid #e5e7eb; border-radius: 8px; margin: 20px 0;">
    <h3 style="color: #374151; margin-top: 0;">Experienta anterioara:</h3>
    <p style="color: #4b5563; line-height: 1.6;">{{nl2br experience}}</p>
  </div>
  {{/ifExists}}
  <div style="background-color: #ffffff; padding: 20px; border: 1px solid #e5e7eb; border-radius: 8px; margin: 20px 0;">
    <h3 style="color: #374151; margin-top: 0;">Motivatie:</h3>
    <p style="color: #4b5563; line-height: 1.6;">{{nl2br motivation}}</p>
  </div>
</div>
