<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
  <h2 style="color: #22c55e;">Propunere noua de parteneriat</h2>
  <div style="background-color: #f0fdf4; padding: 20px; border-radius: 8px; margin: 20px 0; border-left: 4px solid #22c55e;">
    <h3 style="color: #15803d; margin-top: 0;">Tip parteneriat: {{partnershipTypeName}}</h3>
    <p style="font-size: 20px; color: #15803d; margin: 0;"><strong>{{companyName}}</strong></p>
  </div>
  <div style="background-color: #f3f4f6; padding: 20px; border-radius: 8px; margin: 20px 0;">
    <p><strong>Persoana de contact:</strong> {{contactPerson}}</p>
    <p><strong>Functie:</strong> {{position}}</p>
    <p><strong>Email:</strong> {{email}}</p>
    <p><strong>Telefon:</strong> {{phone}}</p>
    {{#ifExists website}}<p><strong>Website:</strong> <a href="{{website}}">{{website}}</a></p>{{/ifExists}}
    {{#ifExists industry}}<p><strong>Domeniu:</strong> {{industry}}</p>{{/ifExists}}
    {{#ifExists employees}}<p><strong>Angajati:</strong> {{employees}}</p>{{/ifExists}}
    {{#ifExists budget}}<p><strong>Buget estimat:</strong> {{budget}}</p>{{/ifExists}}
  </div>
  <div style="background-color: #ffffff; padding: 20px; border: 1px solid #e5e7eb; border-radius: 8px; margin: 20px 0;">
    <h3 style="color: #374151; margin-top: 0;">Domenii de interes:</h3>
    <ul style="color: #4b5563;">
      {{#each interests}}<li>{{this}}</li>{{/each}}
    </ul>
  </div>
</div>
