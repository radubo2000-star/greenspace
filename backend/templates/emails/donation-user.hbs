<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
  <h2 style="color: #ef4444;">Multumim, {{name}}!</h2>
  <div style="font-size: 36px; font-weight: bold; color: #ef4444; text-align: center; margin: 20px 0;">
    {{amount}} RON
  </div>
  <p style="color: #4b5563; line-height: 1.6;">
    {{#ifEquals paymentMethod "card"}}Donatia ta a fost inregistrata cu succes!{{else}}Am primit cererea ta de donatie prin transfer bancar!{{/ifEquals}}
  </p>
  {{#ifEquals paymentMethod "bank"}}
  <div style="background-color: #dbeafe; padding: 20px; border-radius: 8px; margin: 20px 0;">
    <h3 style="color: #1e40af;">Date pentru transfer bancar:</h3>
    <p><strong>Beneficiar:</strong> ASOCIATIA GREEN SPACE</p>
    <p><strong>CIF:</strong> 48872419</p>
    <p><strong>IBAN RON:</strong> RO24BTRLRONCRT0672472001</p>
    <p><strong>IBAN EUR:</strong> RO95BTRLEURCRT0672472001</p>
    <p><strong>Banca:</strong> Banca Transilvania</p>
  </div>
  {{/ifEquals}}
  <p style="color: #4b5563; line-height: 1.6;">
    Cu recunostinta,<br>
    <strong>Echipa Asociatia Green Space</strong>
  </p>
</div>
