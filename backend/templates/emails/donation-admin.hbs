<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
  <h2 style="color: #ef4444;">Donatie Noua!</h2>
  <div style="font-size: 32px; font-weight: bold; color: #ef4444; text-align: center; margin: 20px 0;">
    {{amount}} RON
  </div>
  <div style="background-color: #f3f4f6; padding: 20px; border-radius: 8px; margin: 20px 0;">
    <p><strong>Nume:</strong> {{name}}</p>
    <p><strong>Email:</strong> {{email}}</p>
    {{#ifExists phone}}<p><strong>Telefon:</strong> {{phone}}</p>{{/ifExists}}
    {{#ifExists message}}<p><strong>Mesaj:</strong> {{message}}</p>{{/ifExists}}
    <p><strong>Tip:</strong> {{#if isRecurring}}Recurenta (Lunara){{else}}O singura data{{/if}}</p>
    <p><strong>Metoda:</strong> {{#ifEquals paymentMethod "card"}}Card Bancar{{else}}Transfer Bancar{{/ifEquals}}</p>
  </div>
</div>
