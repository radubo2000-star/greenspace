# Environment Configuration
NODE_ENV=development
PORT=5000

# URLs
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:5000

# SMTP Configuration (for sending emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Configuration
ADMIN_EMAIL=contact@asociatiagreenspace.ro
EMAIL_FROM=noreply@asociatiagreenspace.ro

# File Upload Configuration
MAX_FILE_SIZE=10485760
MAX_VIDEO_SIZE=104857600
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png,image/gif,image/webp,video/mp4,video/webm,video/quicktime,video/x-msvideo,video/mpeg

# API Configuration (for single domain deployment)
API_PREFIX=
