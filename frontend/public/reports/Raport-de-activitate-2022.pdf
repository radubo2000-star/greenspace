<script>
  document.addEventListener('DOMContentLoaded', function () {
    const forms = document.querySelectorAll('.wpcf7 form');

    forms.forEach(function (form) {
      const submitButton = form.querySelector('input[type="submit"], button[type="submit"]');

      if (submitButton) {
        submitButton.addEventListener('click', function () {
          // Creăm și afișăm mesajul de confirmare
          let msg = document.createElement('div');
          msg.innerText = "Mulțumim! Mesajul a fost trimis cu succes.";
          msg.style.padding = "15px";
          msg.style.backgroundColor = "#e0ffe0";
          msg.style.border = "1px solid #b2d8b2";
          msg.style.color = "#2a662a";
          msg.style.fontWeight = "bold";
          msg.style.marginTop = "15px";
          msg.style.borderRadius = "5px";
          msg.style.textAlign = "center";

          // Adăugăm mesajul imediat sub formular
          form.parentNode.insertBefore(msg, form.nextSibling);

          // Așteptăm 5 secunde și redirecționăm
          setTimeout(function () {
            window.location.href = "https://asociatiagreenspace.ro/";
          }, 5000); // ← 5 secunde
        });
      }
    });
  });
</script>



