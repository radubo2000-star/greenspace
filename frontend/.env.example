# Frontend Configuration Example
# Copy this file to .env for development or .env.production for production

# ======================
# Backend API Configuration
# ======================

# Environment
VITE_NODE_ENV=development

# Backend URL
# Development (automatically uses localhost with PORT)
# VITE_BACKEND_URL=http://localhost:5000

# Production - Set this for your production backend API
# VITE_BACKEND_URL=https://api.asociatiagreenspace.ro

# Backend Port (for local development and E2B environment)
# Used to construct backend URLs in both localhost and E2B
VITE_PORT=5000

# Note: The system automatically detects:
# 1. Production: Uses VITE_BACKEND_URL when VITE_NODE_ENV=production
# 2. E2B environment (.e2b.app domains) - uses VITE_PORT
# 3. Production domain (asociatiagreenspace.ro) - uses api subdomain
# 4. Local development (localhost with VITE_PORT)
#
# See BACKEND_CONFIG.md for detailed documentation

# ======================
# Firebase Configuration
# ======================
# Get these values from Firebase Console:
# https://console.firebase.google.com/
# Project Settings > General > Your apps > Firebase SDK snippet > Config

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ======================
# Notes
# ======================
# 1. Never commit .env files with real credentials to git
#
# 2. For production, create .env.production with production values
#
# 3. After changing .env, restart the dev server:
#    npm run dev
#
# 4. For production build:
#    npm run build
#    (uses .env.production automatically)
#
# 5. Firebase configuration is optional but required for:
#    - Gallery admin features
#    - Firebase Storage for images/videos
#    - Real-time database features
#
# 6. To get Firebase credentials:
#    - Go to https://console.firebase.google.com/
#    - Select your project
#    - Click on Project Settings (gear icon)
#    - Scroll down to "Your apps"
#    - Click on the web app icon (</>)
#    - Copy the config values
